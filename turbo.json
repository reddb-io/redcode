{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      // Topological, not arbitrary: the CLI build bundles the app, which imports sources the SDK
      // build generates. An empty `dependsOn` disabled that ordering, so the two raced and the
      // loser read a file that did not exist yet.
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@reddb-io/redcode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@reddb-io/redcode-core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@reddb-io/redcode-app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@reddb-io/redcode-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@reddb-io/redcode-session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
