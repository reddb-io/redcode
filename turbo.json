{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": ["patches/**", "bunfig.toml", ".npmrc", ".github/actions/setup-bun/**"],
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@opencode/cli#typecheck": {
      "dependsOn": ["^typecheck", "@opencode/core#typecheck"]
    },
    "@reddb-io/redcode-design-app#typecheck": {
      "dependsOn": ["^typecheck", "@opencode/core#typecheck", "@opencode/server#typecheck"]
    },
    "@opencode/server#typecheck": {
      "dependsOn": ["^typecheck", "@opencode/core#typecheck"]
    },
    "@opencode/simulation#typecheck": {
      "dependsOn": ["^typecheck", "@opencode/core#typecheck"]
    },
    "@opencode/tui#typecheck": {
      "dependsOn": ["^typecheck", "@opencode/core#typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@opencode/ai#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/codemode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/function#test": {
      "outputs": []
    },
    "@opencode/httpapi-codegen#test": {
      "outputs": []
    },
    "@opencode/server#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/cli#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/tui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/latex#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode/core#typecheck": {
      "outputs": ["node_modules/.ts-dist/**"]
    },
    "@opencode/app#typecheck": {
      "outputs": ["node_modules/.ts-dist/**"]
    }
  }
}
