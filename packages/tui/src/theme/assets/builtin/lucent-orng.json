{
  "base": {
    "categorical": ["red", "orange", "blue", "cyan"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#ffffff",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
