        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.interactive.200"
    },
    "scrollbar": {
      "base": "$hue.accent.200"
    },
    "diff": {
      "text": {
        "added": "$hue.blue.200",
        "removed": "#c53b53",
