{
  "base": {
    "categorical": ["purple", "cyan", "green", "orange", "blue", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.orange.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "#ff5722"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#d3dae3"
    },
    "scrollbar": {
      "base": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.accent.200"
      },
      "background": {
        "added": "#e8f5e9",
        "removed": "#ffebee",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#e8f5e9",
          "removed": "#ffebee"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "#ff5722",
      "function": "$hue.orange.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.200",
      "number": "$hue.red.200",
      "type": "$hue.accent.200",
      "operator": "#ff5722",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.orange.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.accent.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "#ff5722",
