{
  "base": {
    "categorical": ["green", "purple", "yellow", "orange", "blue", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.orange.200"
        },
        "success": {
          "base": "$hue.yellow.200"
        },
        "info": {
          "base": "$hue.interactive.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.400"
    },
    "scrollbar": {
      "base": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "$hue.yellow.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#0a2e1a",
        "removed": "#2d1b1b",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.yellow.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "#7791a6",
        "background": {
          "added": "#0a2e1a",
          "removed": "#2d1b1b"
        }
      }
    },
    "syntax": {
      "comment": "#637777",
      "keyword": "$hue.accent.200",
      "function": "$hue.interactive.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.orange.200",
      "number": "#f78c6c",
      "type": "$hue.yellow.200",
      "operator": "$hue.green.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.interactive.200",
      "link": "$hue.green.200",
      "linkText": "$hue.interactive.200",
      "code": "$hue.yellow.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.accent.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.green.200",
      "image": "$hue.green.200",
      "imageText": "$hue.interactive.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#d6deeb",
        "300": "#9aacc1",
        "400": "#5f7e97",
        "500": "#345067",
        "600": "#0b253a",
        "700": "#0b253a",
        "800": "#011627",
        "900": "#000811"
      },
      "red": {
        "100": "#fc756e",
        "200": "#ef5350",
        "300": "#d14342",
        "400": "#b43434",
        "500": "#982526",
        "600": "#7c1519",
        "700": "#62040c",
        "800": "#450105",
        "900": "#290102"
      },
      "orange": {
        "100": "#fee6c7",
        "200": "#ecc48d",
        "300": "#cba775",
        "400": "#aa8a5d",
        "500": "#8b6f47",
        "600": "#6d5431",
        "700": "#503b1d",
        "800": "#352408",
        "900": "#1a0f01"
      },
      "yellow": {
        "100": "#edfec9",
        "200": "#c5e478",
        "300": "#a7c360",
        "400": "#8aa249",
        "500": "#6e8333",
        "600": "#53651d",
        "700": "#3a4904",
        "800": "#232d03",
        "900": "#0e1401"
      },
      "green": {
        "100": "#97fbe8",
        "200": "#7fdbca",
        "300": "#68bcac",
        "400": "#519d90",
        "500": "#3b8074",
        "600": "#256459",
        "700": "#0f4940",
        "800": "#032e28",
        "900": "#011612"
      },
      "blue": {
        "100": "#abc6fc",
        "200": "#82aaff",
        "300": "#6d91de",
        "400": "#5979be",
        "500": "#46629f",
        "600": "#334b80",
        "700": "#223664",
        "800": "#112248",
        "900": "#040f2e"
      },
      "purple": {
        "100": "#deaffd",
        "200": "#c792ea",
        "300": "#ac7ccb",
        "400": "#9166ad",
        "500": "#775190",
        "600": "#5e3c74",
        "700": "#462959",
        "800": "#30173f",
        "900": "#1b0627"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
