          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#737a8c"
    },
    "scrollbar": {
      "base": "#5a607d"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "removed": "#c53b53",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "#59595b",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.interactive.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.accent.200",
      "type": "#8c6c3e",
      "operator": "#007197",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
