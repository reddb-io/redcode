{
  "base": {
    "categorical": ["purple", "green", "yellow", "blue", "red", "cyan"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#363a4f"
    },
    "scrollbar": {
      "base": "#494d64"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "#f5a97f"
      },
      "background": {
        "added": "#29342b",
        "removed": "#3a2a31",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#223025",
          "removed": "#2f242b"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "#c6a0f6",
      "function": "$hue.interactive.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "#f5a97f",
      "type": "$hue.yellow.200",
      "operator": "#91d7e3",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "#c6a0f6",
      "link": "$hue.interactive.200",
      "linkText": "#91d7e3",
      "code": "$hue.green.200",
      "blockQuote": "$hue.yellow.200",
      "emphasis": "$hue.yellow.200",
      "strong": "#f5a97f",
      "horizontalRule": "#a5adcb",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "#91d7e3",
      "image": "$hue.interactive.200",
      "imageText": "#91d7e3",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#eef2fe",
        "200": "#cad3f5",
        "300": "#aeb6d6",
        "400": "#939ab7",
        "500": "#52556a",
        "600": "#181926",
        "700": "#1e2030",
        "800": "#24273a",
        "900": "#2a2e44"
      },
      "red": {
        "100": "#fba9b3",
        "200": "#ed8796",
        "300": "#ce727f",
        "400": "#af5d6a",
        "500": "#924955",
        "600": "#753640",
        "700": "#5a232d",
        "800": "#3f121b",
        "900": "#27030a"
      },
      "yellow": {
        "100": "#fef7e9",
        "200": "#eed49f",
        "300": "#ccb484",
        "400": "#aa956a",
        "500": "#8a7852",
        "600": "#6b5b3a",
        "700": "#4e4023",
        "800": "#33270e",
        "900": "#181001"
      },
      "green": {
        "100": "#c1faaf",
        "200": "#a6da95",
        "300": "#8cbb7c",
        "400": "#729c64",
        "500": "#5a7f4d",
        "600": "#426237",
        "700": "#2c4722",
        "800": "#172e0e",
        "900": "#041700"
      },
      "cyan": {
        "100": "#a4f4e8",
        "200": "#8bd5ca",
        "300": "#73b6ad",
        "400": "#5c9990",
        "500": "#467c74",
        "600": "#30615a",
        "700": "#1b4641",
        "800": "#062e29",
        "900": "#011613"
      },
      "blue": {
        "100": "#aec8fb",
        "200": "#8aadf4",
        "300": "#7494d4",
        "400": "#5f7bb5",
        "500": "#4b6496",
        "600": "#384d79",
        "700": "#25375d",
        "800": "#142343",
        "900": "#05102a"
      },
      "purple": {
        "100": "#feeaf8",
        "200": "#f5bde6",
        "300": "#d2a0c5",
        "400": "#b184a5",
        "500": "#906886",
        "600": "#714e68",
        "700": "#53364c",
        "800": "#371f31",
        "900": "#1d0a18"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
