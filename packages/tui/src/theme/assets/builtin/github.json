{
  "base": {
    "categorical": ["purple", "cyan", "green", "yellow", "blue", "red", "orange"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.orange.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#d0d7de"
    },
    "scrollbar": {
      "base": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.interactive.200"
      },
      "background": {
        "added": "#dafbe1",
        "removed": "#ffebe9",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#dafbe1",
          "removed": "#ffebe9"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.red.200",
      "function": "$hue.purple.200",
      "variable": "$hue.orange.200",
      "string": "$hue.interactive.200",
      "number": "$hue.accent.200",
      "type": "$hue.orange.200",
      "operator": "$hue.red.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.interactive.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.accent.200",
      "code": "#bf3989",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "#d0d7de",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.accent.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.accent.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
