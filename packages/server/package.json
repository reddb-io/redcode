{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/server",
  "version": "2.0.18",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run build:console && bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p test/docker-workers/tsconfig.json",
    "probe:workerd": "bun run script/workerd-probe.ts",
    "build:console": "bun run script/console-ui.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@opencode/client": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/simulation": "workspace:*",
    "@opencode/util": "workspace:*",
    "@reddb-io/multi-rpc": "0.29.6",
    "@reddb-io/toon": "0.29.6",
    "@reddb-io/toon-rpc": "0.29.6",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@reddb-io/design-system": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "jose": "6.2.9",
    "playwright-core": "1.59.1",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
