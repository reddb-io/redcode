{
  "$schema": "https://opencode.ai/config.json",
  "providers": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "worktree": {
    "auto": false,
  },
  "permissions": [
    { "action": "github-triage", "resource": "*", "effect": "deny" },
    { "action": "github-pr-search", "resource": "*", "effect": "deny" },
  ],
}
